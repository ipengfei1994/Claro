# Development mode works without Docker or external services.
CLARO_APP__MODE=development
CLARO_LOGGING__LEVEL=INFO

# Optional overrides for real services. Full mode requires all three.
# CLARO_DATABASE__URL=postgresql+psycopg://claro@127.0.0.1:5432/claro
# CLARO_REDIS__URL=redis://127.0.0.1:6379/0
# CLARO_KAFKA__BOOTSTRAP_SERVERS=127.0.0.1:9092
# CLARO_KAFKA__TOPIC=claro.content.events.v1
# CLARO_UI__PORT=8501
# CLARO_UI__THEME=system

# Optional advisory LLM layer. Disabled by default; when enabled both base URL
# and API key are required. Keep real credentials in process environment only.
# CLARO_RISK__LLM__ENABLED=true
# CLARO_RISK__LLM__BASE_URL=https://example.invalid/v1
# CLARO_RISK__LLM__API_KEY=
# CLARO_RISK__LLM__MODEL=gpt-4o-mini
